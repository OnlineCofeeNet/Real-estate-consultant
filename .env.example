# ===========================================
# تنظیمات محیطی پروژه مشاور املاک فراز
# ===========================================
# این فایل را کپی کنید و نام آن را به .env تغییر دهید:
#   cp .env.example .env
#
# هرگز فایل .env واقعی را در گیت کامیت نکنید.

# ---------- دیتابیس PostgreSQL ----------
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=your_strong_password_here
SQL_DATABASE=real_estate

# ---------- امنیت ----------
# یک رشته تصادفی و بلند (حداقل ۳۲ کاراکتر) برای امضای session
# می‌توانید با دستور زیر بسازید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# ---------- محیط اجرا ----------
NODE_ENV=development

# ---------- اختیاری (برای پیام‌رسان‌ها در آینده) ----------
# TELEGRAM_BOT_TOKEN=
# BALE_BOT_TOKEN=
# RUBIKA_BOT_TOKEN=
# SMS_API_KEY=
