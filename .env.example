# ================================
# Real Estate Consultant - Environment Variables
# Copy this file to .env and fill in the values
# ================================

# PostgreSQL Database
SQL_HOST=localhost
SQL_USER=postgres
SQL_PASSWORD=your_password_here
SQL_DB_NAME=real_estate

# For drizzle-kit (migrations) - can be same as above or a privileged user
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=your_password_here

# Authentication secret - REQUIRED in production
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Runtime environment
NODE_ENV=development

# Optional: server port (currently hardcoded to 3000 in server.ts)
# PORT=3000
