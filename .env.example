# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL - required unless DB_MOCK=true in development
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=change-me
SQL_DB_NAME=real_estate_consultant
SQL_SSL=false
SQL_POOL_MAX=10
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_IDLE_TIMEOUT_MS=30000

# Development only. NEVER enable this in production.
DB_MOCK=false

# Authentication / security
AUTH_SECRET=replace-with-a-long-random-secret
BACKUP_ENCRYPTION_KEY=replace-with-a-strong-backup-key

# AI / Firebase integrations
GEMINI_API_KEY=
FIREBASE_API_KEY=
