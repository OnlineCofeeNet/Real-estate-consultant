# ===========================================
# تنظیمات محیطی پروژه مشاور املاک فراز
# ===========================================
# cp .env.example .env

# ---------- دیتابیس PostgreSQL ----------
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=your_strong_password_here
SQL_DB_NAME=real_estate
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=your_strong_password_here

# ---------- امنیت ----------
# حداقل ۳۲ کاراکتر تصادفی؛ در Production اجباری است.
AUTH_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# ---------- محیط اجرا ----------
NODE_ENV=development

# ---------- Backup ----------
# برای رمزنگاری Backup در Production یک کلید تصادفی قوی تنظیم کنید.
# BACKUP_ENCRYPTION_KEY=change_this_to_a_long_random_backup_key
# در Production بدون این مقدار، ایجاد Backup باید قبل از انتشار Production تنظیم شود.

# ==================================================
# ذخیره رسانه (عکس / فیلم)
# ==================================================
# local = دیسک سرور | s3 = MinIO / AWS S3 / Cloudflare R2
STORAGE_DRIVER=local
AGENCY_STORAGE_QUOTA_MB=2048
MEDIA_MAX_IMAGE_DIMENSION=1920
MEDIA_JPEG_QUALITY=82

# ---------- S3 / MinIO / R2 ----------
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=auto
# S3_BUCKET=real-estate-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=http://127.0.0.1:9000/real-estate-media
# S3_ACL=private

# ---------- CDN ----------
# CDN_BASE_URL=https://cdn.example.com
