# PostgreSQL
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=your_password
SQL_DATABASE=real_estate
# سازگاری با نام‌های قدیمی
SQL_DB_NAME=real_estate

# امنیت
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NODE_ENV=development
PORT=3000

# ذخیره فایل (local | s3)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# در صورت استفاده از S3 / MinIO / R2
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# سهمیه فضای هر آژانس (مگابایت)
AGENCY_STORAGE_QUOTA_MB=2048
