# Database (PostgreSQL)
SQL_HOST=localhost
SQL_USER=postgres
SQL_PASSWORD=your_password
SQL_DB_NAME=real_estate

# For drizzle-kit migrations (can be same as above or a privileged user)
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=your_password

# Authentication – REQUIRED in production. Generate a long random string.
# Example: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret

# Environment
NODE_ENV=development

# Optional: override default port (currently hardcoded to 3000 in server.ts)
# PORT=3000
