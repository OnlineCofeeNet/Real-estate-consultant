{
  "name": "real-estate-consultant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "مدیریت مشتریان و صدور فاکتور برای مشاوران املاک",
  "scripts": {
    "dev": "tsx src/server/supervisor.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/server/supervisor.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/supervisor.cjs && cp src/server/api-guard.mjs dist/server-api-guard.mjs",
    "start": "node dist/supervisor.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=src/db/drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "form-data": "^4.0.6",
    "framer-motion": "^13.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "moment-jalaali": "^0.10.5",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.2",
    "num2persian": "^4.3.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.87.0",
    "react-hot-toast": "^2.6.0",
    "react-multi-date-picker": "^4.5.2",
    "recharts": "^3.10.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.1",
    "uuid": "^14.0.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.2.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
